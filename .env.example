# Datenbank (SQLite — Pfad zur gaeb.db)
# Standard: ./data/gaeb.db (relativ zum Projektordner)
# DB_PATH=/app/data/gaeb.db

# Easyjob Live-Suche (OAuth2 Password Flow)
EJ_BASE_URL=http://EASYJOB-TEST:8008

# Easyjob Datenbank (pyodbc – direkter DB-Zugriff)
EJ_DB_SERVER=EASYJOB-TEST\SQLEXPRESS
EJ_DB_NAME=easyjob
EJ_DB_UID=sa
EJ_DB_PWD=your_db_password

# Session-Sicherheit (beliebigen langen String setzen)
SESSION_SECRET=change-me-to-a-long-random-string

# Admin-Benutzer (kommaseparierte EJ-Loginnamen, Groß-/Kleinschreibung egal).
# Nur diese sehen die Admin-Seite und die Mapping-Quellen auf der Import-Seite.
ADMIN_LOGINS=admin,dryhire

# Bieter-Firmendaten (eigene Firma) für den D84-Export (Bieter-/CTR-Block).
BIDDER_NAME1=music & lightdesign gmbh
BIDDER_STREET=Bruckenbachstraße 34
BIDDER_PCODE=71229
BIDDER_CITY=Leonberg

# Ersteller-Kennung im D84-Export (GAEBInfo ProgSystem/ProgName).
GAEB_PROG_SYSTEM=GAEB2EJ
GAEB_PROG_NAME=GAEB→Easyjob Export

# MwSt-Satz (%) für die Angebotssumme im D84-Export (Standard 19).
GAEB_VAT=19

